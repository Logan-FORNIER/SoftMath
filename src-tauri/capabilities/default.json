{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions principales de SoftMath (dialogues natifs et système de fichiers pour les notes locales)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "process:default",
    "process:allow-restart",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://generativelanguage.googleapis.com/**" },
        { "url": "https://api.anthropic.com/**" },
        { "url": "http://*:*" },
        { "url": "http://*:*/*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://*/*" },
        { "url": "https://*/*" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    }
  ]
}

